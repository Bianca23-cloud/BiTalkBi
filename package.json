{
  "name": "bitalkbi",
  "version": "3.0.0",
  "description": "BiTalkBi — application gratuite et open source pour apprendre 15 langues avec un tuteur IA, même sans internet (fusion de BIBILEARN et BiaTalk).",
  "main": "electron/main.js",
  "author": {
    "name": "Bianca23-cloud",
    "email": "Bianca23-cloud@users.noreply.github.com"
  },
  "homepage": "https://github.com/Bianca23-cloud/BiTalkBi",
  "license": "MIT",
  "scripts": {
    "build:web": "python3 scripts/build.py",
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.github.bianca23cloud.bitalkbi",
    "productName": "BiTalkBi",
    "files": [
      "electron/**",
      "www/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "BiTalkBi-Windows-Setup.${ext}",
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "BiTalkBi-Windows-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "build/icon.png",
      "artifactName": "BiTalkBi-Linux.${ext}",
      "synopsis": "Apprendre 15 langues hors ligne"
    }
  }
}